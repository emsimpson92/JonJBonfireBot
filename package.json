{
  "name": "jonj-bonfire-bot",
  "version": "0.1.0",
  "description": "Discord bot with slash commands for FAQ, playtest, eternals, items, and glossary lookups, plus player lobbies.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch --include \"data/**/*.json\" src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.6.0"
  }
}
