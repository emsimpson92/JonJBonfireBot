# Copy to .env and fill in real values. Never commit .env.

# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=PLACEHOLDER_BOT_TOKEN

# For local testing. Right-click your server -> Copy Server ID (Developer Mode must be on).
# Set this and commands register to that one server on startup, appearing instantly.
# Leave it unset in production to register globally, which can take up to an hour to show up.
GUILD_ID=YOUR_GUILD_ID

# The one server the lobby commands are registered to; no other server sees them.
# Leave it unset and it falls back to GUILD_ID. With neither set, the lobby commands aren't
# registered anywhere.
LOBBY_GUILD_ID=YOUR_LOBBY_GUILD_ID

# The one channel in that server /createlobby works in. Leave it unset and lobbies can be posted
# in any of its channels.
LOBBY_CHANNEL_ID=YOUR_LOBBY_CHANNEL_ID

# Sliding-window rate limits, counted over the last 60 seconds. Commands and button clicks are
# counted separately, each from every server together, from one server and from one person.
# Reaching MAX_REQUESTS_PER_SERVER_PER_MINUTE posts a "Slow down" notice in the channel; reaching
# any other limit shows the same notice to that person only.
# Non-numeric or non-positive values fall back to the defaults (500, 50, 10, 750, 75, 10).
MAX_REQUESTS_PER_MINUTE=500
MAX_REQUESTS_PER_SERVER_PER_MINUTE=50
MAX_REQUESTS_PER_USER_PER_MINUTE=10
MAX_BUTTON_CLICKS_PER_MINUTE=750
MAX_BUTTON_CLICKS_PER_SERVER_PER_MINUTE=75
MAX_BUTTON_CLICKS_PER_USER_PER_MINUTE=10

# Where Discord fetches item icons and eternal portraits from; image paths in data/ are appended
# to it. Defaults to the main branch on GitHub. Point it at another branch to show images that
# haven't been merged yet.
# IMAGE_BASE_URL=https://raw.githubusercontent.com/emsimpson92/JonJBonfireBot/main/
