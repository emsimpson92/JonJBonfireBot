# Copy to .env and fill in real values. Never commit .env.

# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=PLACEHOLDER_BOT_TOKEN

# Right-click your server -> Copy Server ID (Developer Mode must be on).
# Set this and commands register to that one server on startup, appearing instantly.
# Leave it unset to register globally, which can take up to an hour to show up.
# Also used to build direct https://discord.com/channels/... links.
GUILD_ID=YOUR_GUILD_ID

# Hex color for embeds.
EMBED_COLOR=#E25822

# Sliding-window rate limits, counted over the last 60 seconds.
# MAX_REQUESTS_PER_MINUTE is the whole bot; reaching it posts a notice in the channel.
# MAX_REQUESTS_PER_USER_PER_MINUTE is one person; reaching it DMs them instead.
# Non-numeric or non-positive values fall back to these defaults.
MAX_REQUESTS_PER_MINUTE=10
MAX_REQUESTS_PER_USER_PER_MINUTE=5
